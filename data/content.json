              "v": [
                {
                  "name": "Universal Seoul",
                  "tagline": "장애인 이동권 기반 공공 이동 서비스 설계",
                  "body": "서울 생활이동 데이터를 활용해 교통약자의 이동 수요와 기존 서비스 공급 간 미스매치를 분석하고, 노선 및 마이크로 허브를 제안했다. 공공서비스 최적화와 자원배분 관점을 적용한 사례로, '''산업공학 전공자로서의 정체성이 가장 뚜렷하게 드러나는 프로젝트'''다.",
                  "award": "서울특별시 빅데이터 활용 경진대회 특별상 (4위)"
                },
                {
                  "name": "핸드타월 절감 프로젝트",
                  "tagline": "행동 개입과 공간 설계를 통한 사용량 감축",
                  "body": "화장실 물기로 인한 핸드타월 과다 사용 문제를 정의하고, 인조 이끼 등 공간적 넛지를 활용한 행동 변화 솔루션을 제안했다. 건물관리 이해관계자 인터뷰, 절감 효과 검증을 위한 파일럿 설계, 유한킴벌리 바이사이클 등 자원순환 사업과의 연계를 검토했다.",
                  "award": ""
                },
                {
                  "name": "마중물",
                  "tagline": "귀농 의사결정 지원 플랫폼",
                  "body": "귀농 과정의 정보 비대칭과 의사결정 장벽을 문제로 정의하고, 사용자 조사·페르소나 설계부터 UX/UI와 비즈니스 모델까지 수행했다.",
                  "award": "아산나눔재단 두어스 창업 부트캠프 1기 최우수상"
